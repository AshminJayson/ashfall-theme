# Ashfall — a neutral ash-grey Ghostty theme.
# Soft off-white foreground on near-neutral grey; warm coral and green accents.
#
# Install: copy this file to ~/.config/ghostty/themes/ashfall
#          then add `theme = ashfall` to ~/.config/ghostty/config

# --- Base colors ---
background = 202125
foreground = EAEBEE

# Selection: blue tint so highlighted text stays readable
selection-background = 33508A
selection-foreground = FFFFFF

# Cursor
cursor-color = 8FB6E8

# --- ANSI palette (0-7 normal, 8-15 bright) ---
palette = 0=#414347
palette = 1=#FF6B6B
palette = 2=#8CE0A0
palette = 3=#FFD479
palette = 4=#6FA8FF
palette = 5=#C792EA
palette = 6=#56C9D6
palette = 7=#DEE0E3
palette = 8=#8B8E94
palette = 9=#FF8B8B
palette = 10=#A6E8B4
palette = 11=#FFE3A3
palette = 12=#9CC4FF
palette = 13=#DDB0F6
palette = 14=#8BE9F0
palette = 15=#FFFFFF
