{
  "$schema": "vscode://schemas/color-theme",
  "name": "Ashfall",
  "type": "dark",
  "semanticHighlighting": true,
  // Palette mirrors themes/ashfall (Ghostty) and colors/ashfall.lua (Neovim).
  "colors": {
    // Editor surface
    "editor.background": "#202125",
    "editor.foreground": "#EAEBEE",
    "editorLineNumber.foreground": "#54575E",
    "editorLineNumber.activeForeground": "#9CC4FF",
    "editorCursor.foreground": "#8FB6E8",
    "editor.lineHighlightBackground": "#2A2C30",
    "editor.selectionBackground": "#33508A",
    "editor.selectionHighlightBackground": "#2C3A5780",
    "editor.wordHighlightBackground": "#2C3A5780",
    "editor.wordHighlightStrongBackground": "#33508A80",
    "editor.findMatchBackground": "#FFD47966",
    "editor.findMatchHighlightBackground": "#FFD47933",
    "editor.hoverHighlightBackground": "#2C3A5780",
    "editorBracketMatch.background": "#33508A",
    "editorBracketMatch.border": "#56C9D6",
    "editorIndentGuide.background1": "#32353A",
    "editorIndentGuide.activeBackground1": "#54575E",
    "editorWhitespace.foreground": "#414347",
    "editorRuler.foreground": "#32353A",
    "editorGutter.background": "#202125",
    "editorError.foreground": "#FF6B6B",
    "editorWarning.foreground": "#FFD479",
    "editorInfo.foreground": "#6FA8FF",
    "editorHint.foreground": "#56C9D6",

    // Diff/git gutter markers
    "editorGutter.addedBackground": "#8CE0A0",
    "editorGutter.modifiedBackground": "#FFD479",
    "editorGutter.deletedBackground": "#FF6B6B",

    // Diff editor
    "diffEditor.insertedTextBackground": "#8CE0A022",
    "diffEditor.removedTextBackground": "#FF6B6B22",

    // Window chrome
    "foreground": "#EAEBEE",
    "focusBorder": "#33508A",
    "selection.background": "#33508A",
    "errorForeground": "#FF6B6B",
    "descriptionForeground": "#7A7E84",
    "icon.foreground": "#9CC4FF",
    "widget.shadow": "#141518",
    "contrastBorder": "#32353A",

    // Activity bar + side bar
    "activityBar.background": "#1A1C1F",
    "activityBar.foreground": "#EAEBEE",
    "activityBar.inactiveForeground": "#7A7E84",
    "activityBar.activeBorder": "#6FA8FF",
    "activityBarBadge.background": "#6FA8FF",
    "activityBarBadge.foreground": "#202125",
    "sideBar.background": "#1A1C1F",
    "sideBar.foreground": "#DEE0E3",
    "sideBarTitle.foreground": "#9CC4FF",
    "sideBarSectionHeader.background": "#202125",
    "sideBarSectionHeader.foreground": "#EAEBEE",

    // Trees and lists
    "list.activeSelectionBackground": "#2B2D32",
    "list.activeSelectionForeground": "#EAEBEE",
    "list.inactiveSelectionBackground": "#26282C",
    "list.hoverBackground": "#26282C",
    "list.focusBackground": "#2B2D32",
    "list.highlightForeground": "#FFE3A3",
    "list.errorForeground": "#FF6B6B",
    "list.warningForeground": "#FFD479",

    // Status bar
    "statusBar.background": "#1A1C1F",
    "statusBar.foreground": "#DEE0E3",
    "statusBar.noFolderBackground": "#1A1C1F",
    "statusBar.debuggingBackground": "#33508A",
    "statusBar.debuggingForeground": "#EAEBEE",
    "statusBarItem.remoteBackground": "#33508A",
    "statusBarItem.remoteForeground": "#EAEBEE",

    // Title bar
    "titleBar.activeBackground": "#1A1C1F",
    "titleBar.activeForeground": "#EAEBEE",
    "titleBar.inactiveBackground": "#1A1C1F",
    "titleBar.inactiveForeground": "#7A7E84",

    // Editor tabs
    "editorGroupHeader.tabsBackground": "#1A1C1F",
    "tab.activeBackground": "#202125",
    "tab.activeForeground": "#EAEBEE",
    "tab.activeBorderTop": "#6FA8FF",
    "tab.inactiveBackground": "#1A1C1F",
    "tab.inactiveForeground": "#7A7E84",
    "tab.border": "#1A1C1F",

    // Bottom panels
    "panel.background": "#202125",
    "panel.border": "#32353A",
    "panelTitle.activeForeground": "#EAEBEE",
    "panelTitle.inactiveForeground": "#7A7E84",

    // Inputs, dropdowns, badges
    "input.background": "#1A1C1F",
    "input.foreground": "#EAEBEE",
    "input.border": "#32353A",
    "input.placeholderForeground": "#7A7E84",
    "inputOption.activeBorder": "#6FA8FF",
    "dropdown.background": "#1A1C1F",
    "dropdown.foreground": "#EAEBEE",
    "dropdown.border": "#32353A",
    "badge.background": "#33508A",
    "badge.foreground": "#EAEBEE",

    // Buttons
    "button.background": "#6FA8FF",
    "button.foreground": "#202125",
    "button.hoverBackground": "#9CC4FF",
    "button.secondaryBackground": "#2B2D32",
    "button.secondaryForeground": "#EAEBEE",

    // Suggest widget / quick pick / hovers / menus
    "editorWidget.background": "#1A1C1F",
    "editorWidget.border": "#32353A",
    "editorSuggestWidget.background": "#1A1C1F",
    "editorSuggestWidget.border": "#32353A",
    "editorSuggestWidget.foreground": "#EAEBEE",
    "editorSuggestWidget.selectedBackground": "#2B2D32",
    "editorSuggestWidget.highlightForeground": "#FFE3A3",
    "editorHoverWidget.background": "#1A1C1F",
    "editorHoverWidget.border": "#32353A",
    "quickInput.background": "#1A1C1F",
    "quickInput.foreground": "#EAEBEE",
    "quickInputList.focusBackground": "#2B2D32",
    "pickerGroup.foreground": "#9CC4FF",
    "pickerGroup.border": "#32353A",
    "menu.background": "#1A1C1F",
    "menu.foreground": "#EAEBEE",
    "menu.selectionBackground": "#2B2D32",

    // Scrollbar and minimap
    "scrollbar.shadow": "#141518",
    "scrollbarSlider.background": "#54575E55",
    "scrollbarSlider.hoverBackground": "#54575E88",
    "scrollbarSlider.activeBackground": "#64676EAA",
    "minimap.selectionHighlight": "#33508A",
    "minimap.findMatchHighlight": "#FFD479",

    // SCM decorations
    "gitDecoration.modifiedResourceForeground": "#FFD479",
    "gitDecoration.deletedResourceForeground": "#FF6B6B",
    "gitDecoration.untrackedResourceForeground": "#8CE0A0",
    "gitDecoration.ignoredResourceForeground": "#64676E",
    "gitDecoration.conflictingResourceForeground": "#C792EA",

    // Integrated terminal — mirrors the Ghostty ANSI palette
    "terminal.background": "#202125",
    "terminal.foreground": "#EAEBEE",
    "terminalCursor.foreground": "#8FB6E8",
    "terminal.selectionBackground": "#33508A",
    "terminal.ansiBlack": "#414347",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#8CE0A0",
    "terminal.ansiYellow": "#FFD479",
    "terminal.ansiBlue": "#6FA8FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#56C9D6",
    "terminal.ansiWhite": "#DEE0E3",
    "terminal.ansiBrightBlack": "#8B8E94",
    "terminal.ansiBrightRed": "#FF8B8B",
    "terminal.ansiBrightGreen": "#A6E8B4",
    "terminal.ansiBrightYellow": "#FFE3A3",
    "terminal.ansiBrightBlue": "#9CC4FF",
    "terminal.ansiBrightMagenta": "#DDB0F6",
    "terminal.ansiBrightCyan": "#8BE9F0",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#92959C", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#8CE0A0" }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#8BE9F0" }
    },
    {
      "name": "Number / constant",
      "scope": ["constant.numeric", "constant.language", "constant.other"],
      "settings": { "foreground": "#FFD479" }
    },
    {
      "name": "Boolean / language constant",
      "scope": ["constant.language.boolean"],
      "settings": { "foreground": "#FFE3A3" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#EAEBEE" }
    },
    {
      "name": "Variable builtin (this/self)",
      "scope": ["variable.language", "variable.language.this", "variable.language.special"],
      "settings": { "foreground": "#FF6B6B" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#EAEBEE" }
    },
    {
      "name": "Property / field",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": { "foreground": "#9CC4FF" }
    },
    {
      "name": "Function / method",
      "scope": ["entity.name.function", "meta.function-call.generic", "support.function"],
      "settings": { "foreground": "#6FA8FF" }
    },
    {
      "name": "Function builtin",
      "scope": ["support.function.builtin", "keyword.other.special-method"],
      "settings": { "foreground": "#9CC4FF" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#C792EA" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#DEE0E3" }
    },
    {
      "name": "Preprocessor / import / macro",
      "scope": ["meta.preprocessor", "keyword.control.import", "keyword.control.directive", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#DDB0F6" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#56C9D6" }
    },
    {
      "name": "Type builtin",
      "scope": ["support.type.primitive", "storage.type.primitive"],
      "settings": { "foreground": "#8BE9F0" }
    },
    {
      "name": "Constructor / namespace / module",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.other.inherited-class"],
      "settings": { "foreground": "#56C9D6" }
    },
    {
      "name": "Constant / enum member",
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#FFD479" }
    },
    {
      "name": "Decorator / attribute",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "meta.attribute"],
      "settings": { "foreground": "#DDB0F6" }
    },
    {
      "name": "Punctuation / delimiter",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#DEE0E3" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF6B6B" }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FFD479" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#6FA8FF", "fontStyle": "bold" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#56C9D6", "fontStyle": "underline" }
    },
    {
      "name": "Markup raw / code",
      "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code"],
      "settings": { "foreground": "#8CE0A0" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FFE3A3", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#C792EA", "fontStyle": "italic" }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#8CE0A0" }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#FF6B6B" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF8B8B" }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#EAEBEE",
    "property": "#9CC4FF",
    "variable.readonly": "#FFD479",
    "function.defaultLibrary": "#9CC4FF",
    "variable.defaultLibrary": "#FF6B6B",
    "type": "#56C9D6",
    "class": "#56C9D6",
    "enumMember": "#FFD479",
    "namespace": "#56C9D6",
    "decorator": "#DDB0F6"
  }
}
